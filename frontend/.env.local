# Frontend Environment Variables

# API Configuration - Change to /api for Vite proxy
VITE_API_URL=/api
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_EMERGENCY_MODE=true
VITE_ENABLE_AI_SUMMARY=true
VITE_ENABLE_AUDIT_LOG=true

# UI Configuration
VITE_APP_TITLE=AI Patient Record Intelligence
VITE_SESSION_TIMEOUT=900000
