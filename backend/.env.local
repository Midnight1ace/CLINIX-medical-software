# Backend Environment Variables

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Database
DATABASE_URL=sqlite:///patient_records.db
# For PostgreSQL: postgresql://user:password@localhost:5432/patient_records

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000

# LLM Configuration (for AI summaries)
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Pharmacy Integration
PHARMACY_API_URL=https://pharmacy-system.example.com/api
PHARMACY_API_KEY=pharmacy-key

# Clinic Integration
CLINIC_API_URL=https://clinic-system.example.com/api
CLINIC_API_KEY=clinic-key

# Lab Integration
LAB_API_URL=https://lab-system.example.com/api
LAB_API_KEY=lab-key
